""")


def analyze_average(con: duckdb.DuckDBPyConnection) -> duckdb.DuckDBPyRelation:
    _fill_zeros(con)
    return con.sql("""
WITH
    weekly_task_durations (week, w_durations) AS (
        SELECT
            date_trunc ('week', "start") AS week,
            list_reduce (array_agg ("end" - "start"), lambda acc, x: acc + x) ,
        FROM
            tracking
        GROUP BY
            week
    ),
    monthly_task_durations (month, m_durations) AS (
        SELECT
            date_trunc ('month', "start") AS month,
            list_reduce (array_agg ("end" - "start"), lambda acc, x: acc + x) ,
        FROM
            tracking
        GROUP BY
            month
    ),
    yearly_task_durations (year, y_durations) AS (
        SELECT
            date_trunc ('year', "start") AS year,
            list_reduce (array_agg ("end" - "start"), lambda acc, x: acc + x) ,
        FROM
            tracking
        GROUP BY
            year
    )
SELECT
    date_trunc('second', avg(y_durations)) as yearly_average,
    date_trunc('second', avg(m_durations)) as monthly_average,
    date_trunc('second', avg(w_durations)) as weekly_average
FROM
    yearly_task_durations,
    monthly_task_durations,
    weekly_task_durations;
""")


def print_completions():
    if len(sys.argv) < 3:
        return
    COMP_WORDS = sys.argv[2].split(" ")

    other = COMP_WORDS[:-1]

    if len(other) == 0:
        return

    if len(other) == 1:
        print("analyze end rename start")
        return

    has_full_task_completion = sys.argv[2].count("\"") >= 2 or (
        sys.argv[2].count("\"") == 0 and len(other) >= 3)
    if other[1] in ["start", "rename"] and not has_full_task_completion:
        print_task_suggestions()
        return

    if other[1] in ["a", "analyze"]:
        print_analysis_suggestions(other)
        return


def print_analysis_suggestions(other: list[str]):
    if len(other) == 2:
        print("average per_task per_week per_day per_month total")
        return

    if not other[2] in ["average", "total", "per_task", "per_week", "per_day", "per_month"]:
        return

    if other[-1] in ["--after",
                     "--before",
                     "--on",
                     "--week-of"]:
        print("today yesterday this-week")
        return

    suggestions = ""

    options: list[str] = ["--after",
                          "--before",
                          "--on",
                          "--week-of",
                          "--export"]

    # An option suggestion is excluded, if any option mentioned in the array is already present
    excluded_option_suggestions: dict[str, list[str]] = {
        "--after": ["--on", "--week-of"],
        "--before": ["--on", "--week-of"],
        "--on": ["--after", "--before", "--week-of"],
        "--week-of": ["--after", "--before", "--on"],
    }

    for option in options:
        if option in other:
            continue

        if any(s in other for s in excluded_option_suggestions.get(option, [])):
            continue

        suggestions += option + " "

    print(suggestions.strip())


def print_task_suggestions():
    task_suggestions = "Default "

    try:
        con = _load_tracking_data()
    except:
        print(task_suggestions.strip())
        return

    t = con.sql("SELECT DISTINCT task FROM tracking ORDER BY task")

    for res in t.fetchall():
        task_suggestions += f"'{res[0]}' "

    print(task_suggestions.strip())


def main():
    USAGE_MESSAGE = """Usage: time_tracking COMMAND

Commands:
  analyze                     Analyze statistics on previous work
  rename <src> <dest>         Rename all occurences of <src> to <dest>
  start                       Start tracking time for a task
  stop                        Stop tracking time for a task
  """

    if (len(sys.argv) < 2):
        print(USAGE_MESSAGE)
        return

    if sys.argv[1] in ["start"]:
        start_task()
    elif sys.argv[1] in ["stop", "end", "e"]:
        stop_task()
    elif sys.argv[1] in ["rename", "r"]:
        rename_tasks()
    elif sys.argv[1] in ["analyze", "a"]:
        analyze_tasks()
    elif sys.argv[1] in ["completions"]:
        print_completions()
    else:
        print(USAGE_MESSAGE)


if __name__ == "__main__":
    main()
